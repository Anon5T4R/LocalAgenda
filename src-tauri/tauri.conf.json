{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalAgenda",
  "version": "0.6.5",
  "identifier": "com.localagenda.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1442",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalAgenda",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": ["binaries/llama/*", "third-party/*"],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-entry.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["ics"],
        "name": "Calendário iCalendar",
        "description": "Evento/calendário iCalendar",
        "role": "Editor",
        "mimeType": "text/calendar"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
